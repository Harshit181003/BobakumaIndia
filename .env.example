# Root-level convenience; each package can also use its own .env

## MySQL (local)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=bobakuma
MYSQL_USER=bobakuma_user
MYSQL_PASSWORD=bobakuma_password

## Backend
# cPanel / PaaS often inject PORT — backend prefers PORT over BACKEND_PORT
BACKEND_PORT=4000
# BIND_HOST=0.0.0.0
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bobakuma India <no-reply@bobakuma.in>"

APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated extra allowed CORS origins (prod: include www + non-www)
# CORS_ORIGINS=https://bobakuma.in,https://www.bobakuma.in

# Display pricing: INR is stored in DB; NPR/LKR = INR effective × rate × adjuster (see /api/pricing/regions)
PRICING_INR_TO_NPR=1.60
PRICING_INR_TO_LKR=3.55
PRICING_ADJUST_NP=1.00
PRICING_ADJUST_LK=1.00

## Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
