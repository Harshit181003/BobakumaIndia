# Root-level convenience; each package can also use its own .env

## MySQL (local)
MYSQL_HOST=127.0.0.1
# Repo Docker maps host 3307 → MySQL 3306. If you use another MySQL, set MYSQL_PORT accordingly.
MYSQL_PORT=3307
MYSQL_DATABASE=bobakuma
MYSQL_USER=bobakuma_user
# Must match `docker-compose.yml` MYSQL_PASSWORD. Changing compose env alone does NOT update an existing volume;
# first-time init only. To reset: `docker compose down`, delete `database/.mysql-data`, `docker compose up -d`, re-import SQL.
MYSQL_PASSWORD=bobakuma_password

## Backend
# cPanel / PaaS often inject PORT — backend prefers PORT over BACKEND_PORT
BACKEND_PORT=4000
# BIND_HOST=0.0.0.0
# Behind nginx / LB / PaaS that sets X-Forwarded-For (production): number of proxy hops, e.g. TRUST_PROXY=1
# TRUST_PROXY=1
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Bobakuma India <no-reply@bobakuma.in>"

APP_PUBLIC_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Comma-separated extra allowed CORS origins (prod: include www + non-www)
# CORS_ORIGINS=https://bobakuma.in,https://www.bobakuma.in

# Display pricing: INR is stored in DB; NPR/LKR = INR effective × rate × adjuster (see /api/pricing/regions)
PRICING_INR_TO_NPR=1.60
PRICING_INR_TO_LKR=3.55
PRICING_ADJUST_NP=1.00
PRICING_ADJUST_LK=1.00

## Frontend
# Production: full API origin (e.g. https://api.example.com). Leave empty for local dev so the browser
# uses same-origin `/api/*` (proxied by Next to BACKEND_DEV_URL / 127.0.0.1:4000 — see `next.config.mjs`).
# Do not set this to http://127.0.0.1:4000 when you open the shop under a custom host (e.g. http://dev:3001).
NEXT_PUBLIC_API_BASE_URL=
# Server-side fetches during `next dev` (optional; defaults to NEXT_PUBLIC or 127.0.0.1:4000).
# INTERNAL_API_BASE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_RAZORPAY_KEY_ID=
